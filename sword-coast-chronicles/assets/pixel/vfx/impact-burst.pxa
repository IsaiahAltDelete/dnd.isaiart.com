@name  fx-impact-burst
@scale 10
@size  32x32
# The moment a spell lands: contact point, a white-hot star, a shockwave that
# tears loose from a hollowing heart, sparks thrown past it, then embers and
# a breath of smoke. Eight frames, accelerating out and easing off (40ms at
# contact, 120ms for the last embers), played once.
#
# Authored in arcane violet; @recolor registers fx-impact-burst-fire, -cold,
# -lightning, -necrotic, -radiant ... from palette.js magicRamp colours, so a
# Fire Bolt and a Ray of Frost hit with the same shape in their own light.
@anchor 16,16
@point centre 16,16
@ramp  spell arcane 5 01234

@anim burst burst-0 burst-1 burst-2 burst-3 burst-4 burst-5 burst-6 burst-7 loop=0
@recolor spell magic
# The shockwave rings are drawn two pixels heavy on purpose (a 1px ring
# vanishes in one 50ms frame), so the pixel-perfect `doubles` rule is off.
@lint skip=pillow,light,stray,jaggy,orphan,doubles

@frame burst-0 dur=40
