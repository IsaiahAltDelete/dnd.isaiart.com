@name floor-waystone
@size 16x16
@scale 10
@anchor 0,0
@palette
d #414850 carved shadow
m #626b6a aged stone
l #8a8c7a worn lip
@lint skip=light,pillow,doubles
# Flat engraving, not a raised object. Upper-left lips are deliberately faint.
# L-corners are the filled intersections of compass arms and the diamond rim.
@frame idle
