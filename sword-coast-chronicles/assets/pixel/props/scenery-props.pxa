@name scenery-props
@size 16x16
@scale 12
@anchor 0,0
@palette
K #292d34 outline
D #505963 stone shadow
M #838b8a stone
L #b7bbab stone light
H #d3d2bc worn stone edge
w #9b6639 oak
b #614124 oak shadow
l #c59252 oak light
i #58616b iron
j #939b9b iron light
k #343b44 iron shadow
g #356043 leaves
h #588344 leaf light
s #213e34 leaf shadow
t #72944d leaf tip
e #716854 soil
@lint skip=doubles,jaggy
# Intersecting flutes, hoops and splintered edges intentionally form L corners.
# The bush contour scallops around unequal leaf clusters rather than a smooth dome.

