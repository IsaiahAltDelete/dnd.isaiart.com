@name  wolf-sculpt
@scale 6
@size  32x24
# Four-footed silhouette: a low back, raised shoulder ruff, tapered muzzle and brush tail.
# Tufted fur and bent hocks deliberately interrupt the silhouette.
@anchor 16,24
@ramp  scale #8e8c80 5 abcde
@ramp  leather #826147 5 fghij
@ramp  wing #776477 5 klmno
@ramp  bone #c4baa0 5 pqrst

@palette
K #211d28  outline
E #e8b653  eye
Z #12131b  pupil
W #f2e7c7  glint
R #8a3d3c  tongue

@lint skip=jaggy

