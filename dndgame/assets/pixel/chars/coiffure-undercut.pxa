@name coiffure-undercut
@size 16x24
@anchor 8,24
# The d triangle is a filled shaved scalp plane, not a one-pixel diagonal line.
@lint skip=doubles

@palette
K OUTLINE
h HAIR
H HAIR_D
j HAIR_L
d SKIN_D
x ACCENT

